# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK di-commit (lihat .gitignore).

# Gemini API (Google AI Studio). Boleh beberapa key dipisah koma; permintaan digilir antar-key.
GEMINI_API_KEY=

# Google Fact Check Tools API: API key biasa (bukan service account), dari Google Cloud Console.
FACTCHECK_API_KEY=

# GNews (https://gnews.io/register), paket gratis 100 permintaan/hari.
NEWS_API_KEY=

# Kontak (email atau URL) di User-Agent; wajib agar Wikipedia tidak menolak (403).
SAKSI_CONTACT=

# Opsional
# SAKSI_MODEL=gemma-4-26b-a4b-it
# SAKSI_TOKEN_BUDGET=150000
# SAKSI_PREFETCH=1
# SAKSI_A2A_TOKEN=
